      <property name="styleSheet">
       <string notr="true">/* =========================================
   GLOBAL BACKGROUND &amp; TEXT
   ========================================= */
QMainWindow {
    background-color: off-white; /* Soft, modern off-white background */
}

QLabel {
    color: #2C3E50; /* Dark slate gray for readable text */
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 14px;
}

/* Make Titles look like Headers */
QLabel#lblWelcome {
    font-size: 24px;
    font-weight: bold;
    color: #2980B9;
}

/* =========================================
   TEXT BOXES (Line Edits)
   ========================================= */
QLineEdit {
    background-color: #FFFFF;
    border: 2px solid #DCE4EC;
    border-radius: 8px; /* Rounded corners */
    padding: 8px 12px;
    font-size: 14px;
    color: #34495E;
}

/* When the user clicks inside the text box */
QLineEdit:focus {
    border: 2px solid #3498DB; /* Highlight blue */
    background-color: #FAFCFF;
}

/* =========================================
   BUTTONS
   ========================================= */
QPushButton {
    background-color: #3498DB; /* Primary Blue */
    color: white;
    border: none;
    border-radius: 8px; /* Rounded corners */
    padding: 10px 20px;
    font-size: 14px;
    font-weight: bold;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
}

/* When the mouse hovers over the button */
QPushButton:hover {
    background-color: #2980B9; /* Slightly darker blue */
}

/* When the button is clicked */
QPushButton:pressed {
    background-color: #1F618D;
}

/* Secondary/Back Buttons (If you want a red or grey button) */
QPushButton#btnExit, QPushButton#btnLogout, QPushButton#btnBack {
    background-color: #E74C3C; /* Soft Red */
}

QPushButton#btnExit:hover, QPushButton#btnLogout:hover, QPushButton#btnBack:hover {
    background-color: #C0392B; /* Darker Red */
}
</string>
