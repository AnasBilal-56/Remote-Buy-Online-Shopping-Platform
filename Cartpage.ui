  <property name="styleSheet">
   <string notr="true">/* Main Window */
QWidget#mainWindow {
    background-color: #ffffff;
}

/* Header &amp; Breadcrumbs */
QLabel#breadcrumb {
    color: #888888;
    font-size: 11px;
}

/* Page Title */
QLabel#cartTitle {
    font-size: 24px;
    font-weight: bold;
    color: #000000;
    margin-top: 10px;
}

/* Progress Tracker Bar */
QProgressBar#cartProgress {
    border: 1px solid #e0e0e0;
    background-color: #f5f5f5;
    height: 6px;
    text-align: center;
}

QProgressBar#cartProgress::chunk {
    background-color: #4b49ff; /* The signature blue */
    width: 20px;
}

/* Cart Table Headers */
QLabel#columnHeader {
    color: #000000;
    font-weight: bold;
    font-size: 13px;
    border-bottom: 1px solid #eeeeee;
    padding-bottom: 5px;
}

/* Item Frame */
QFrame#itemRow {
    border-bottom: 1px solid #f0f0f0;
    padding: 15px 0px;
}

/* Product Image Placeholder */
QLabel#productImg {
    background-color: #f7f7f7;
    border-radius: 4px;
}

/* Checkout Section */
QFrame#footer {
    background-color: #ffffff;
    border-top: 2px solid #f0f0f0;
}

QPushButton#checkoutBtn {
    background-color: #3b3bc4;
    color: white;
    font-weight: bold;
    font-size: 14px;
    padding: 12px 40px;
    border-radius: 2px;
}

QPushButton#checkoutBtn:hover {
    background-color: #2a2a9e;
}
QPushButton#checkoutBtn {
    background-color: #3b3bc4;
    color: white;
    border-radius: 2px;
    padding: 12px;
}</string>
  </property>
  <widget class="QScrollArea" name="scrollArea">
   <property name="geometry">
