   <property name="styleSheet">
    <string notr="true">QWidget {
    background-color: #f5f6fa;
    font-family: Segoe UI;
    font-size: 13px;
    color: #2d3436;
}
QTableWidget {
    background-color: white;
    border: none;
    border-radius: 8px;
    gridline-color: #f0f0f0;
}
QTableWidget::item {
    padding: 10px 8px;
    border-bottom: 1px solid #f0f0f0;
    color: #2d3436;
}
QTableWidget::item:selected {
    background-color: #e8f4fd;
    color: #2d3436;
}
QHeaderView::section {
    background-color: #2d3436;
    color: white;
    padding: 12px 8px;
    font-weight: bold;
    font-size: 13px;
    border: none;
}
QPushButton {
    padding: 10px 20px;
    border-radius: 6px;
    font-weight: bold;
    font-size: 13px;
    border: none;
}
QPushButton#m_checkoutBtn {
    background-color: #00b894;
    color: white;
}
QPushButton#m_checkoutBtn:hover {
    background-color: #00a381;
}
QPushButton#m_removeBtn {
    background-color: #d63031;
    color: white;
}
QPushButton#m_removeBtn:hover {
    background-color: #c0392b;
}
QPushButton#m_updateBtn {
    background-color: #fdcb6e;
    color: #2d3436;
}
QPushButton#m_updateBtn:hover {
    background-color: #f9b324;
}
QPushButton#m_backBtn {
    background-color: white;
    color: #2d3436;
    border: 2px solid #dfe6e9;
}
QPushButton#m_backBtn:hover {
    background-color: #f5f6fa;
}
QPushButton#m_historyBtn {
    background-color: #6c5ce7;
    color: white;
}
QPushButton#m_historyBtn:hover {
    background-color: #5f4dd0;
}
QLabel#m_totalLabel {
    background-color: white;
    border-radius: 8px;
    padding: 12px 20px;
    font-size: 16px;
    font-weight: bold;
    color: #00b894;
}</string>
